# ----------------------------------------------------------------- server
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# ------------------------------------------------------------------- auth
# Virgülle ayrılmış yerel API anahtarları (istemciler bunu Bearer olarak yollar).
API_KEYS=sk-local-dev-key
# Boşsa tüm API_KEYS admin sayılır (eski davranış). Doluysa oturum kimliğini
# değiştiren /v1/admin uçları (cookie/curl/capture/apikey/refresh) yalnız bu
# anahtarlara açılır; normal istemci anahtarı sızsa bile upstream oturumu
# ele geçirilemez. Telegram botu da bu anahtarı kullanmalıdır.
# DİKKAT: /v1/admin önce API_KEYS doğrulamasından geçer. Buraya yazdığın
# anahtar API_KEYS listesinde de olmalı; yoksa 401 alırsın (açılışta uyarı loglanır).
ADMIN_API_KEYS=
AUTH_DISABLED=false

# ------------------------------------------------------------------- CORS
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# --------------------------------------------------------------- upstream
# ŞEMASIZ domain yazın (https:// otomatik eklenir).
# Render'da önerilen tek secret: tam create-evaluation cURL'ü UPSTREAM_CURL
# ortam değişkenine yapıştırılır. Çok satırlı değeri .env'e elle yazmak yerine
# yerelde scripts/curl_to_env.py importer'ını kullanın.
# DİKKAT: UPSTREAM_CURL doluysa açılışta UPSTREAM_COOKIE'yi EZER; ikisini birden
# doldurmayın (uyarı loglanır: upstream_cookie_shadowed_by_curl).
# UPSTREAM_CURL=

# cURL'den türeyen, elle yazılmaması gereken alanlar. cURL içe aktarılınca
# otomatik dolar; restart'ta model kimliği kaybolmasın diye burada belgelenir.
# UPSTREAM_CAPTURED_MODEL_ID=
# 0 = yalnız kimlik bilgileri, 1 = tarayıcı parmak izi dahil tam snapshot.
# UPSTREAM_SNAPSHOT_VERSION=1

# İstek başına üretilen `cx` alanı varsayılan olarak GÖNDERİLMEZ (canlı
# gözlemlerde bu alan olmadan da başarılı istek atıldı). Göndermek için:
# UPSTREAM_CX_SEND=false
# Sabit bir `cx` YAZMAYIN: tek kullanımlıktır, ikinci istekte reddedilir.
# UPSTREAM_CX=

TARGET_DOMAIN=example-llm.com
UPSTREAM_SCHEME=https
# Son normal sohbet cURL'ünde doğrulanan yol. Kimlik URL'de değil, gövdedeki id alanında.
# Upstream değişirse yeni cURL'ü curl_to_env.py ile içe aktarın; yanlış yol HTTP 404 üretir.
UPSTREAM_STREAM_PATH=/nextjs-api/stream/create-evaluation
UPSTREAM_REFERER_PATH=/text/direct
# Gövdeye yazılacak mode alanı. Boş bırakılırsa alan gönderilmez.
UPSTREAM_MODE=direct-battle
# Gövdedeki captcha alanının adı: recaptchaV3Token | recaptchaV2Token
# Tarayıcı isteğinizdeki --data-raw içinden birebir kopyalayın!
UPSTREAM_RECAPTCHA_FIELD=recaptchaV3Token
# Tarayıcınızın gönderdiği Accept-Language ile birebir aynı olmalı:
UPSTREAM_ACCEPT_LANGUAGE=tr,en;q=0.9,en-GB;q=0.8,en-US;q=0.7
UPSTREAM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36 Edg/154.0.0.0
# Oturum gerekiyorsa tarayıcıdan alınan ham Cookie başlığı:
UPSTREAM_COOKIE=

# --- Authorization ---------------------------------------------------------
# ÖNEMLİ: Tarayıcı isteğinizde "authorization" başlığı YOKSA bunu false bırakın;
# olmayan bir başlık eklemek istek parmak izini bozar. Hedef 401 dönüyorsa true yapın.
# true iken token, UPSTREAM_COOKIE içinden otomatik ayıklanır
# (düz değer, URL-encoded, JSON, base64-JSON ve parçalı ".0/.1" çerezler desteklenir).
UPSTREAM_AUTH_FROM_COOKIE=false
# Otomatik ayıklama yerine token'ı doğrudan vermek isterseniz (en yüksek öncelik):
UPSTREAM_ACCESS_TOKEN=
# Token'ı taşıyan çerez adı/adları (virgülle). Boşsa sezgisel arama yapılır.
# Örn: UPSTREAM_TOKEN_COOKIE_NAMES=sb-access-token,my_app_session
UPSTREAM_TOKEN_COOKIE_NAMES=
# Authorization şeması. Boş bırakılırsa token ham gönderilir.
UPSTREAM_AUTH_SCHEME=Bearer
# JWT "exp" süresi dolmuşsa logda uyar (istek yine de denenir):
UPSTREAM_WARN_ON_EXPIRED_TOKEN=true
# Ek başlıklar "K1=V1;K2=V2" biçiminde. Importer sabit tarayıcı parmak izi
# ve deployment başlıklarını aktarır; değerde ';' varsa kayıpsız JSON nesnesi
# kullanılır (eski biçim desteklenmeye devam eder).
UPSTREAM_EXTRA_HEADERS=dnt=1
# UPSTREAM_PROXY=http://user:pass@127.0.0.1:8080
UPSTREAM_VERIFY_TLS=true
UPSTREAM_HTTP2=true

# --- Ek hesaplar (2., 3., 4.) -----------------------------------------------
# scripts/curl_to_env.py cURL'leri sırayla atıldığında her birini ayrı bir yuvaya
# yazar: 1. hesap yukarıdaki soneksiz anahtarları, sonraki hesaplar _2/_3/_4
# soneksli anahtarları kullanır. Elle de doldurabilirsiniz.
# Yuvalar Settings içinde açıkça tanımlıdır; en fazla 4 hesap okunur.
# static kipte her hesabın KENDİ captcha token'ı olmalı. browser/external kipinde
# bu statik değerler yok sayılır ve sağlayıcıdan taze token alınır.
# 3. ve 4. hesap için aynı alanlar _3/_4 sonekleriyle kullanılır.
UPSTREAM_ACCOUNT_NAME=hesap-1
UPSTREAM_ACCOUNT_2_NAME=
TARGET_DOMAIN_2=
UPSTREAM_COOKIE_2=
UPSTREAM_ACCESS_TOKEN_2=
UPSTREAM_AUTH_FROM_COOKIE_2=false
UPSTREAM_AUTH_SCHEME_2=Bearer
UPSTREAM_REFERER_PATH_2=
UPSTREAM_USER_AGENT_2=
UPSTREAM_ACCEPT_LANGUAGE_2=
UPSTREAM_TOKEN_COOKIE_NAMES_2=
RECAPTCHA_STATIC_TOKEN_2=

# 3. ve 4. yuvalar: aynı alanların _3/_4 sonekli hali. Kullanmıyorsan hiç yazma;
# boş bırakılan yuva hesap havuzuna girmez.
# UPSTREAM_ACCOUNT_3_NAME=
# TARGET_DOMAIN_3=
# UPSTREAM_COOKIE_3=
# UPSTREAM_ACCESS_TOKEN_3=
# UPSTREAM_AUTH_FROM_COOKIE_3=
# UPSTREAM_AUTH_SCHEME_3=
# UPSTREAM_REFERER_PATH_3=
# UPSTREAM_USER_AGENT_3=
# UPSTREAM_ACCEPT_LANGUAGE_3=
# UPSTREAM_TOKEN_COOKIE_NAMES_3=
# RECAPTCHA_STATIC_TOKEN_3=
# UPSTREAM_ACCOUNT_4_NAME=
# TARGET_DOMAIN_4=
# UPSTREAM_COOKIE_4=
# UPSTREAM_ACCESS_TOKEN_4=
# UPSTREAM_AUTH_FROM_COOKIE_4=
# UPSTREAM_AUTH_SCHEME_4=
# UPSTREAM_REFERER_PATH_4=
# UPSTREAM_USER_AGENT_4=
# UPSTREAM_ACCEPT_LANGUAGE_4=
# UPSTREAM_TOKEN_COOKIE_NAMES_4=
# RECAPTCHA_STATIC_TOKEN_4=

# --- Kota / hesap kısıtlaması tespiti ---------------------------------------
# Hedef servis hesabı kilitlediğinde döndürdüğü metin işaretleri (virgülle ayrılmış).
# Tespit üç yerde yapılır: HTTP hata gövdesi, akıştaki hata olayı (3:) ve yanıtın
# ilk karakterlerindeki düz metin. Yakalanan istek 429 + Retry-After olarak döner
# ve ASLA retry edilmez (tekrar denemek kilit süresini uzatır).
# Gözlemlediğiniz gerçek mesajı buraya birebir yazın.
# NOT: İşaretler ayırt edici olsun. "rate limit" gibi genel bir söz, modelin normal
# cevabında da geçebilir ve düz metin taraması açıkken yanlış alarma yol açar.
UPSTREAM_LIMIT_MARKERS=upstream limit reached,message limit reached,conversation limit reached,daily limit reached,usage limit reached,quota exceeded,rate limit exceeded,too many requests
# Düz metin taramasının penceresi (karakter). 0 = düz metin taraması kapalı (varsayılan).
# Kısıtlama mesajı akışta düz metin olarak görünüyorsa 300 yapın.
QUOTA_TEXT_SCAN_CHARS=0

# --------------------------------------------------------------- timeouts
CONNECT_TIMEOUT=10
READ_TIMEOUT=300
WRITE_TIMEOUT=30
POOL_TIMEOUT=10
TOTAL_REQUEST_TIMEOUT=600
STREAM_IDLE_TIMEOUT=120

# ------------------------------------------------------- upstream keepalive
# 0 = kapalı. 10800 = üç saatte bir gerçek, kısa non-stream completion.
# Kota/CAPTCHA kullanır; Render Free uyuduğunda durur ve auth refresh garantisi yoktur.
# --- Erişim token'ı otomatik yenileme (refresh token)
# Erişim token'ı ~1 saatte ölür; refresh token varsa kendiliğinden yenilenir.
UPSTREAM_REFRESH_ENABLED=true
UPSTREAM_REFRESH_LEEWAY_SECONDS=600
UPSTREAM_REFRESH_CHECK_INTERVAL_SECONDS=60
# Boşsa uç nokta çerezdeki JWT'nin `iss` alanından türetilir.
UPSTREAM_REFRESH_URL=
# Çerezden okunamıyorsa refresh token'ı doğrudan verin. Yenilemede dönen yeni
# değer bellekte buraya yazılır; env'deki değer restart'ta taban kabul edilir.
UPSTREAM_REFRESH_TOKEN=
# Upstream `apikey` istiyorsa (boş bırakılırsa siteden otomatik keşfedilir).
# Supabase/GoTrue ise `/auth/v1/token` 401 "No API key found in request" döner;
# çözüm projenin **anon/publishable** anahtarı (Dashboard > Project Settings >
# API). Uygulanınca yenileme hemen denenir, deploy gerekmez:
#   POST /v1/admin/upstream/apikey  {"apikey":"<anon>"}
UPSTREAM_REFRESH_API_KEY=
# Dönen refresh/access token ve sürüm damgasının restart sonrası korunması için
# yerel durum dosyası (atomik yazılır, .gitignore/snapshot dışıdır):
UPSTREAM_STATE_FILE=.cache/upstream_state.json
# Free Render'da kalıcı disk yoktur. Dönen oturumun restart/deploy sonrası korunması
# için RENDER_API_KEY girin; RENDER_SERVICE_ID Render'da otomatik sağlanır.
# Env senkronizasyonu deploy tetiklemez. Yerel geliştirmede ikisi de boş kalabilir.
# RENDER_API_KEY=
# RENDER_SERVICE_ID=

UPSTREAM_KEEPALIVE_INTERVAL_SECONDS=0
UPSTREAM_KEEPALIVE_MODEL=max
# İlk probe'un gecikmesi (sn). Deploy sonrası durumu bir saat beklemeden
# öğrenmek için 60 iyi bir varsayılandır.
UPSTREAM_KEEPALIVE_INITIAL_DELAY_SECONDS=60
# Aralığa eklenecek rastgele sapma (sn, ±). Tam saatte atılan istek desenini kırar.
UPSTREAM_KEEPALIVE_JITTER_SECONDS=300
# Günde bir kez `stream: true` ile gerçek akış yolunu dene (0 = kapalı).
UPSTREAM_KEEPALIVE_STREAM_SMOKE_INTERVAL_SECONDS=86400

# ------------------------------------------------------ arıza bildirimi (Telegram)
# Keepalive/probe arızayı yakalarsa Telegram'a **anlamlı** mesaj gider:
# ne olduğu (upstream_refresh_required, recaptcha_unavailable, kota, ...) ve
# ne yapılacağı. Spam olmaması için: yeni arıza ve düzelme her zaman bildirilir,
# aynı arıza sürdükçe yalnızca aşağıdaki aralıkla tek hatırlatma yapılır.
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_ALERT_REPEAT_SECONDS=21600
# Boş bırakılırsa TELEGRAM_ALLOWED_CHAT_IDS'in ilk kaydı kullanılır.
# TELEGRAM_ALERT_CHAT_ID=

# ------------------------------------------------------------ health & metrics
# /health kimlik doğrulamasızdır; upstream host'u varsayılan olarak gizlenir.
HEALTH_EXPOSE_UPSTREAM=false
# Herkese açık bir adreste metrikleri korumak için true yapın.
METRICS_REQUIRE_AUTH=false

# ------------------------------------------------------------------ pools
MAX_CONNECTIONS=200
MAX_KEEPALIVE_CONNECTIONS=50
MAX_CONCURRENT_UPSTREAM=32

# ------------------------------------------ sürüm damgası kanaryası (409 önlemi)
# Upstream, x-deployment-id / x-arena-web-deployment damgası eskiyse 409
# `refresh_required` döner. Kanarya bu değeri upstream'in kendi sayfasından
# okuyup tazeler; okunamazsa UPSTREAM_CURL'deki değer kullanılır.
# DİKKAT: bu altı adın başında `UPSTREAM_` YOK. `UPSTREAM_DEPLOYMENT_...` yazarsan
# uygulama adı okumaz ve değer sessizce yok sayılır (env_audit bunu yakalar).
DEPLOYMENT_ID_REFRESH_ENABLED=true
DEPLOYMENT_ID_TTL_SECONDS=1800
DEPLOYMENT_PROBE_PATH=/
DEPLOYMENT_PROBE_TIMEOUT=8
# 409 alınınca damga zorla yenilenip istek bir kez tekrar edilsin mi?
DEPLOYMENT_ID_AUTO_RETRY=true
# Damga bulunamazsa eskimiş deployment başlıkları çıkarılıp bir kez denenir.
DEPLOYMENT_STAMP_STRIP_ON_CONFLICT=true

# ------------------------------------------------------ retry & resilience
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=8
BREAKER_ENABLED=true
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_TIMEOUT=30

# ------------------------------------------------------------- rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=30

# ------------------------------------------------------------------ input
MAX_BODY_BYTES=4194304
MAX_MESSAGES=400
MAX_PROMPT_CHARS=500000
# ignore | hint | error
UNSUPPORTED_PARAMS=ignore

# -------------------------------------------------------------- recaptcha
# static | noop | browser | external — gözlenen hedef için unattended browser.
RECAPTCHA_PROVIDER=browser
RECAPTCHA_STATIC_TOKEN=
RECAPTCHA_TOKEN_TTL=100
# browser sağlayıcısı için (site key gizli değil, sayfada herkese açıktır):
RECAPTCHA_SITE_KEY=6LeTGMcsAAAAALuIlkVwIxaAuZA8VledA6d3Nnb0
# v3 | enterprise — gözlenen hedef Enterprise ve chat_submit kullanıyor.
RECAPTCHA_VERSION=enterprise
RECAPTCHA_ACTION=chat_submit
RECAPTCHA_BROWSER_TIMEOUT=45
# external sağlayıcısı için:
RECAPTCHA_EXTERNAL_URL=
RECAPTCHA_EXTERNAL_API_KEY=
RECAPTCHA_EXTERNAL_TIMEOUT=60

# --------------------------------------------------------- Telegram (opsiyonel)
# Token varsa bot aynı Web Service içinde başlar. WRAPPER_BASE_URL kendi PORT'unuzdan,
# WRAPPER_API_KEY ise API_KEYS ilk değerinden otomatik türetilir; ayrıca yazmayın.
# İlk çalıştırmada allowlist boşken /start chat ID gösterir; wrapper çağrısı yapılmaz.
TELEGRAM_BOT_TOKEN=
# İlk kayıt aynı zamanda varsayılan arıza bildirimi hedefidir (bkz. TELEGRAM_ALERTS_*).
TELEGRAM_ALLOWED_CHAT_IDS=
# Yalnız ayrı 'python -m app.telegram.bot' process'i için gerekirse açın:
# WRAPPER_BASE_URL=http://127.0.0.1:8000
# WRAPPER_API_KEY=
TELEGRAM_MODEL=max
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_REQUEST_TIMEOUT=180
TELEGRAM_MAX_REPLY_CHARS=12000

# --- Hesap havuzu / kota ----------------------------------------------------
# ACCOUNT_MSG_BUDGET yumuşak bir bütçedir: hangi hesabın tercih edileceğini
# belirler, isteği engellemez. Gerçek sınır kilitlerden öğrenilir (AIMD).
ACCOUNT_MSG_BUDGET=15
ACCOUNT_QUOTA_WINDOW_SECONDS=1200
ACCOUNT_COOLDOWN_SECONDS=1200
ACCOUNT_MAX_SWITCHES=2
ACCOUNT_BUDGET_GROWTH_STREAK=3

# ---------------------------------------------------------------- session
# Oturum cache'i bellek içidir: tek worker ile çalıştırın, aksi halde her worker
# kendi sohbetini tutar ve rotasyon sayacı paylaşılMAZ.
SESSION_STATELESS=true
# True ise Continue/Cursor gibi OpenAI-uyumlu istemciler (şema dışı conversation_id
# gönderemezler) için sohbet API anahtarı parmak izine bağlanır ve TEK upstream
# sohbetinden ilerlenir; eşik aşılınca yeni sohbet açılır. SESSION_STATELESS bu
# modda yok sayılır.
SESSION_REUSE=false
# Bir upstream sohbeti en fazla bu kadar istek taşısın (0 = sınırsız).
SESSION_ROTATE_AFTER_MESSAGES=35
# Bir upstream sohbeti en fazla bu kadar saniye kullanılsın (0 = yaş sınırı yok).
# Upstream'in kota penceresiyle hizalamak isterseniz örn. 1200 (20 dk) verin.
SESSION_ROTATE_AFTER_SECONDS=0
SESSION_TTL=1800
SESSION_CACHE_SIZE=1024

# ----------------------------------------------------------------- models
MODELS_FILE=config/models.yaml
METRICS_ENABLED=true

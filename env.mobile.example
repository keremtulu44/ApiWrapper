# ============================================================================
# ApiWrapper .env — sıfırdan doldurma dosyası (mobil kurulum)
# Üretildi: python -m scripts.env_template --env
#
# 1. bölümdeki 5 satırı kendi değerinle doldur.
# 2. bölüm hazır; cihaz/hesap değişmediyse dokunma.
# 3. bölümdekileri YAZMA; neden yazmayacağın yanlarında yazıyor.
#
# Doğrulama:  python -m scripts.env_audit .env
# Katman teşhisi: /v1/admin/auth  (yanıtta `verdict`)
# ============================================================================

# ===== 1. DOLDUR =============================================================
# Oturumu değiştiren /v1/admin uçları için anahtar. Boşsa tüm API_KEYS admin sayılır.
ADMIN_API_KEYS=
# Yerel istemci anahtarları, virgülle. İstemci `Authorization: Bearer <bu>` yollar.
API_KEYS=
# Hedef host, ŞEMASIZ (ornek-servis.com). Boş kalırsa /readyz 503 target_domain_not_configured
# döner.
TARGET_DOMAIN=
# Tam create-evaluation cURL'ü, TEK satır. Doldurursan UPSTREAM_COOKIE'yi boş bırak (açılışta
# cURL çerezi ezer).
# Örnek: UPSTREAM_CURL=curl 'https://host/nextjs-api/...' -H 'cookie: ...'
UPSTREAM_CURL=
# Yakalanan cihazın UA'sı, birebir. iPhone: 'iPhone; CPU iPhone OS', Android: 'Android ...
# Mobile', masaüstü: 'Windows NT 10.0'.
UPSTREAM_USER_AGENT=

# ===== 2. HAZIR (mobil profil, dokunma) ==========================================
RECAPTCHA_ACTION=chat_submit
RECAPTCHA_PROVIDER=browser
RECAPTCHA_SITE_KEY=6LeTGMcsAAAAALuIlkVwIxaAuZA8VledA6d3Nnb0
RECAPTCHA_VERSION=enterprise
UPSTREAM_ACCEPT_LANGUAGE=tr,en;q=0.9,en-GB;q=0.8,en-US;q=0.7
UPSTREAM_AUTH_FROM_COOKIE=false
UPSTREAM_AUTH_SCHEME=Bearer
UPSTREAM_CX_SEND=false
UPSTREAM_MODE=direct-battle
UPSTREAM_RECAPTCHA_FIELD=recaptchaV3Token
UPSTREAM_REFERER_PATH=/text/direct
UPSTREAM_SNAPSHOT_VERSION=1
UPSTREAM_STATE_FILE=.cache/upstream_state.json
UPSTREAM_STREAM_PATH=/nextjs-api/stream/create-evaluation

# ===== 3. BOŞ BIRAK / YAZMA ==============================================
# Bilerek kapalı: doldurulması çalışan bir şeyi bozar.
#   RECAPTCHA_EXTERNAL_API_KEY=   — Yalnız `external` sağlayıcısı için
#   RECAPTCHA_EXTERNAL_URL=   — Yalnız `external` sağlayıcısı için
# ⛔ RECAPTCHA_STATIC_TOKEN=   — Boş bırak
#   RENDER_API_KEY=   — Yalnız Render'da restart sonrası oturum korunsun istiyorsan yaz
#   RENDER_SERVICE_ID=   — Render kendisi verir; elle yazma
#   ROOT_PATH=   — Ters proxy alt yolda sunmuyorsa boş
#   TELEGRAM_ALERT_CHAT_ID=   — Boşsa allowlist'in ilk kaydı arıza bildirimi hedefi olur
#   TELEGRAM_ALLOWED_CHAT_IDS=   — İlk `/start` chat ID'yi gösterir; sonra buraya yaz
#   TELEGRAM_BOT_TOKEN=   — Bot kullanmayacaksan boş; doluysa bot aynı servis içinde başlar
#   UPSTREAM_ACCESS_TOKEN=   — Boş bırak
#   UPSTREAM_ACCOUNT_2_NAME=   — Boş bırak
#   UPSTREAM_ACCOUNT_3_NAME=   — Boş bırak
#   UPSTREAM_ACCOUNT_4_NAME=   — Boş bırak
#   UPSTREAM_CAPTURED_MODEL_ID=   — cURL içe aktarılınca kendisi dolar (`modelAId` UUID)
#   UPSTREAM_COOKIE=   — `UPSTREAM_CURL` kullanıyorsan boş
# ⛔ UPSTREAM_CX=   — Boş bırak
#   UPSTREAM_EXTRA_HEADERS=   — `dnt=1` yeterli
#   UPSTREAM_PROXY=   — Proxy yoksa boş; varsa `http://kullanici:sifre@host:port`
#   UPSTREAM_REFRESH_API_KEY=   — Upstream `apikey` istiyorsa; boşsa siteden otomatik keşfedilir
#   UPSTREAM_REFRESH_TOKEN=   — Çerezde refresh token varsa boş bırak
#   UPSTREAM_REFRESH_URL=   — Boş → çerezdeki JWT'nin `iss` alanından türetilir
#   UPSTREAM_TOKEN_COOKIE_NAMES=   — Çerez adını biliyorsan yaz (`arena-auth-prod-v1` gibi); bilmiyorsan boş → sezgisel arama
#   WRAPPER_API_KEY=   — Aynı serviste çalışıyorsa yazma; `API_KEYS` ilk değerinden türetilir
#   WRAPPER_BASE_URL=   — Aynı serviste çalışıyorsa **yazma**; varsayılan yerel adres kullanılır

# 2./3./4. hesap yuvaları (kullanmıyorsan hiç yazma):
#   RECAPTCHA_STATIC_TOKEN_2, RECAPTCHA_STATIC_TOKEN_3, RECAPTCHA_STATIC_TOKEN_4, TARGET_DOMAIN_2, TARGET_DOMAIN_3, TARGET_DOMAIN_4, UPSTREAM_ACCEPT_LANGUAGE_2, UPSTREAM_ACCEPT_LANGUAGE_3, UPSTREAM_ACCEPT_LANGUAGE_4, UPSTREAM_ACCESS_TOKEN_2, UPSTREAM_ACCESS_TOKEN_3, UPSTREAM_ACCESS_TOKEN_4, UPSTREAM_COOKIE_2, UPSTREAM_COOKIE_3, UPSTREAM_COOKIE_4, UPSTREAM_REFERER_PATH_2, UPSTREAM_REFERER_PATH_3, UPSTREAM_REFERER_PATH_4, UPSTREAM_USER_AGENT_2, UPSTREAM_USER_AGENT_3, UPSTREAM_USER_AGENT_4

# syntax=docker/dockerfile:1
# Telegram Background Worker: Web Service Dockerfile'ından bağımsız, hafif imaj.
# Bot wrapper'a HTTP üzerinden gider; Chromium/Playwright bu imajda gerekmez.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY app ./app
RUN pip install --no-cache-dir . \
 && useradd --create-home --uid 10001 appuser \
 && chown -R appuser:appuser /app

USER appuser

# Render Docker arayüzünde Start Command alanı olmasa da bot doğrudan başlar.
CMD ["python", "-m", "app.telegram.bot"]
